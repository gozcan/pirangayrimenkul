# =======================================================
#  SMTP — used by /api/contact to send the iletişim form
#  Copy these into Vercel → Project → Settings → Environment Variables
#  (do NOT commit a real .env.local with the password to git)
# =======================================================
SMTP_HOST=mail.eksioglugrup.tr
SMTP_PORT=465
SMTP_USER=info@pirangyd.com
SMTP_PASS=replace-with-the-mailbox-password
SMTP_SECURE=true

# Optional — recipient and from override.
# Both default to SMTP_USER if unset.
CONTACT_TO=info@pirangyd.com
CONTACT_FROM=info@pirangyd.com
